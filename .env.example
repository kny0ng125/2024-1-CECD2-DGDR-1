# docker-compose 용 환경변수. 이 파일을 .env 로 복사해서 쓴다.
#
# 로컬에 이미 MySQL 이 깔려 있어 3306 이 사용 중이면 MYSQL_PORT 를 바꾸고,
# server/src/main/resources/application.yml 의 접속 URL 포트도 같이 맞출 것.
#   netstat -ano | findstr :3306   → 3306 을 누가 잡고 있는지 확인
#
# ⚠ 주의: MySQL 이미지는 데이터 볼륨이 이미 존재하면 아래 계정/비밀번호를
#   무시한다. 값을 바꿨는데 Access denied 가 나면 볼륨을 지우고 다시 띄울 것.
#   docker compose down -v && docker compose up -d mysql

MYSQL_PORT=3306
MYSQL_DATABASE=dgdr
MYSQL_USER=dgdr
MYSQL_PASSWORD=dgdrpw
MYSQL_ROOT_PASSWORD=rootpw
